# pbilineage configuration.
#
# Copy to .env and fill in. .env is gitignored — never commit a real secret.
# In production, prefer pulling these from Azure Key Vault and exporting them
# into the process environment; this file exists so a laptop run is easy, not
# because a file on disk is the right place for a client secret.

# --- Azure AD app registration (service principal) ---------------------------
# One app registration backs both surfaces below.
PBI_TENANT_ID=00000000-0000-0000-0000-000000000000
PBI_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Either a client secret...
PBI_CLIENT_SECRET=

# ...or a certificate (needs the `msal` package: pip install .[live])
# PBI_CERTIFICATE_PATH=/path/to/private-key.pem
# PBI_CERTIFICATE_THUMBPRINT=

# --- What the service principal needs ----------------------------------------
# Admin REST APIs (Scanner, Export, GetModifiedWorkspaces):
#   * Tenant.Read.All application permission, with admin consent granted
#   * Tenant setting "Service principals can use read-only Power BI admin APIs"
#     enabled, with the app's security group added to it
# XMLA endpoint (Premium / PPU / Fabric workspaces only):
#   * The service principal must be a member of each workspace (Viewer is
#     enough for read)
#   * Tenant setting "Allow XMLA endpoints and Analyze in Excel..." enabled,
#     and the capacity's XMLA endpoint set to Read or Read Write

# --- Collection toggles ------------------------------------------------------
# Turn off XMLA to force every workspace onto the DAX-parser path (useful for
# comparing the two, or when ADOMD.NET is unavailable on the host).
PBI_ENABLE_XMLA=true
# Report export is the slowest part of a scan; off means model lineage only.
PBI_ENABLE_REPORT_EXPORT=true
PBI_ENABLE_DATAFLOWS=true
PBI_EXCLUDE_PERSONAL_WORKSPACES=true

# --- Output ------------------------------------------------------------------
PBI_GRAPH_PATH=out/lineage/graph.json
PBI_STATE_PATH=out/lineage/state.sqlite

# --- Neo4j (optional; the JSON graph store works without it) -----------------
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j
